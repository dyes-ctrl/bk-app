<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nécessaire pour lire l'état des appels entrants -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Pour la notification au boot si la permission est perdue -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nécessaire pour CallInterceptor : TelecomManager.endCall() (API 26+) -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Nécessaire pour READ_PHONE_STATE sur Android 9+ (EXTRA_INCOMING_NUMBER) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".BKApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_call"
        android:label="BK"
        android:supportsRtl="true"
        android:theme="@style/Theme.BK">

        <!-- Activité principale -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            CallScreeningService : intercepte les appels AVANT qu'ils sonnent.
            La permission BIND_SCREENING_SERVICE est requise pour que le système
            puisse lier ce service. Le rôle ROLE_CALL_SCREENING est demandé
            dans MainActivity via RoleManager.
        -->
        <service
            android:name=".BKScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Receiver pour rappeler à l'utilisateur si la permission est perdue au reboot -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            CallInterceptor : couche de sécurité prioritaire pour MIUI.
            Priorité maximale (2147483647) garantit qu'il reçoit PHONE_STATE_RINGING
            avant que MIUI affiche son propre écran d'appel entrant.
            Nécessite READ_PHONE_STATE + ANSWER_PHONE_CALLS.
        -->
        <receiver
            android:name=".CallInterceptor"
            android:exported="false">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
